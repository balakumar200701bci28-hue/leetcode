/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
static inline int XSumSubArray(int* nums, int l, int r, int x) {
    int sum = 0, distinct = 0;
    int freq[51] = {0};
    for (int i = l; i < r; ++i) {
        sum += nums[i];
        if (freq[nums[i]]++ == 0) ++distinct;
    }

    if (distinct < x) return sum;

    sum = 0;
    for (int pick = 0; pick < x; ++pick) {
        int maxFreq = -1, maxVal = -1;
        for (int val = 50; val > 0; --val) {
            if (freq[val] > maxFreq) {
                maxFreq = freq[val];
                maxVal = val;
            }
        }

        sum += maxVal * maxFreq;
        freq[maxVal] = 0;
    }
    return sum;
}
int* findXSum(int* nums, int n, int k, int x, int* rsz) {
    *rsz = n-k+1;
    int* res = (int*)malloc((*rsz) * sizeof(int));
    for (int i = 0; i < *rsz; ++i) {
        res[i] = XSumSubArray(nums, i, i+k, x);
    }
    return res;
}
