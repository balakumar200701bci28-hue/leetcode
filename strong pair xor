static inline int min(int a, int b) {
    return (a < b) ? a : b;
}

int maximumStrongPairXor(int* nums, int numsSize) {
    int max = 0; 
    for (int i = 0; i < numsSize; i++) {
        for (int j = i + 1; j < numsSize; j++) {
            if (abs(nums[i] - nums[j]) <= min(nums[i], nums[j])) {
                int pot = nums[i] ^ nums[j]; 
                if (pot > max) max = pot; 
            }
        }
    }
    return max; 
}
