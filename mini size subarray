int minSubArrayLen(int target, int* nums, int numsSize) {
    int left = 0;
    int right = 0;
    int minSize = 0;
    int sum = 0;

    while(right < numsSize)
    {
        sum += nums[right];
        while (sum - nums[left] >= target)
        {
            sum -= nums[left];
            left++;
        }
        if (sum >= target && (minSize == 0 || right - left + 1 < minSize))
            minSize = right - left + 1;
        right++;
    }
    return (minSize);
}
